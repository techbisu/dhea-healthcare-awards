---
const objectives = [
  {
    title: "Promote Healthcare Excellence",
    desc: "Elevating standards of clinical care, patient safety, hospital management, and diagnostic accuracy across India.",
    icon: `<svg class="w-6 h-6 text-[#f6dd9f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`
  },
  {
    title: "Recognize Industry Leaders",
    desc: "Honoring visionary clinicians, hospital founders, pharma heads, and researchers driving transformation.",
    icon: `<svg class="w-6 h-6 text-[#f6dd9f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`
  },
  {
    title: "Encourage Innovation",
    desc: "Inspiring cutting-edge HealthTech, AI diagnostics, indigenous medical devices, and novel clinical therapies.",
    icon: `<svg class="w-6 h-6 text-[#f6dd9f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  },
  {
    title: "Showcase Best Practices",
    desc: "Providing a national stage to document, share, and replicate breakthrough healthcare methodologies.",
    icon: `<svg class="w-6 h-6 text-[#f6dd9f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>`
  },
  {
    title: "Build Healthcare Ecosystem",
    desc: "Connecting hospitals, diagnostics, pharma giants, startups, regulators, and academic institutions.",
    icon: `<svg class="w-6 h-6 text-[#f6dd9f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>`
  }
];

const whyEnterPoints = [
  {
    title: "Gain Prestigious Industry Recognition",
    desc: "Establish your organization or individual practice among India's elite healthcare achievers with unmatched acclaim."
  },
  {
    title: "Enhance Brand Credibility and Visibility",
    desc: "Elevate your reputation before patients, corporate boards, investors, and national healthcare authorities."
  },
  {
    title: "Showcase Innovation and Excellence",
    desc: "Highlight groundbreaking clinical protocols, patented healthcare technology, or pioneering patient-first initiatives."
  },
  {
    title: "Benchmark Against Industry Leaders",
    desc: "Assess your achievements against top-tier national and international healthcare standards and peers."
  },
  {
    title: "Access Networking Opportunities with Key Decision-Makers",
    desc: "Connect directly with hospital CEOs, Health Ministry officials, VC investors, and pharmaceutical leaders."
  },
  {
    title: "Strengthen Stakeholder Trust and Confidence",
    desc: "Provide tangible third-party validation that reassures patients, partner physicians, and clinical partners."
  },
  {
    title: "Celebrate Your Organization's and Team's Achievements",
    desc: "Reward the tireless devotion of your clinical, administrative, and research teams on a glittering national stage."
  }
];
---

<section id="about" class="relative py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Title -->
    <div class="text-center mb-16">
      <div class="section-badge">DHEA 2026 Overview</div>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6">
        About <span class="gold-text-gradient">DHEA 2026</span>
      </h2>
      <div class="max-w-4xl mx-auto p-8 rounded-3xl bg-gradient-to-b from-[#1c140b]/90 to-[#120d08]/90 border border-[#d4a34b]/30 backdrop-blur-md shadow-2xl relative">
        <div class="text-xs uppercase tracking-widest text-[#d4a34b] font-bold mb-3">Awards Overview</div>
        <p class="font-serif text-lg sm:text-2xl text-[#f3ede2] leading-relaxed italic">
          "The Dose Daily Healthcare Excellence Awards (DHEA) celebrate organizations and professionals transforming healthcare through innovation, leadership, quality, research, patient care, and business excellence."
        </p>
        <div class="mt-4 flex items-center justify-center gap-2 text-xs font-semibold text-[#f6dd9f] uppercase tracking-wider">
          <span>December 2026</span>
          <span>•</span>
          <span>Kolkata, India</span>
        </div>
      </div>
    </div>

    <!-- Objectives Section -->
    <div class="mb-20">
      <div class="text-center mb-10">
        <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-2">
          Core <span class="gold-text-gradient">Objectives</span>
        </h3>
        <p class="text-xs sm:text-sm text-[#c9b8a3]">The guiding mission behind the Dose Daily Healthcare Excellence Awards</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {objectives.map((obj, i) => (
          <div class="glass-card rounded-2xl p-6 relative overflow-hidden group border border-[#d4a34b]/20 bg-[#161009]/80 hover:border-[#d4a34b]/60 transition-all duration-300">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-[#2b1c0e] border border-[#d4a34b]/30 flex items-center justify-center p-2.5 shrink-0" set:html={obj.icon} />
              <div class="font-serif text-lg font-bold text-white group-hover:text-[#f6dd9f] transition-colors">
                {obj.title}
              </div>
            </div>
            <p class="text-xs sm:text-sm text-[#bdae9c] leading-relaxed">
              {obj.desc}
            </p>
          </div>
        ))}
        <!-- Summary Card -->
        <div class="rounded-2xl p-6 border border-[#d4a34b]/40 bg-gradient-to-br from-[#26190c] to-[#160f08] flex flex-col justify-center items-center text-center">
          <div class="text-2xl mb-2">🏆</div>
          <h4 class="font-serif text-lg font-bold text-[#f6dd9f] mb-2">Excellence in Action</h4>
          <p class="text-xs text-[#c9b8a3] mb-4">Join over 1000+ healthcare leaders setting new benchmarks in medical science and healthcare delivery.</p>
          <button 
            type="button"
            onclick="window.openModal('modal-nominate')"
            class="btn-gold px-5 py-2 rounded-lg text-xs font-bold tracking-wider cursor-pointer"
          >
            Enter Now
          </button>
        </div>
      </div>
    </div>

    <!-- Why Enter DHEA 2026? Section -->
    <div id="why-enter" class="pt-6">
      <div class="text-center mb-12">
        <div class="section-badge">Value & Impact</div>
        <h3 class="font-serif text-2xl sm:text-4xl font-bold text-white mb-4">
          Why Enter <span class="gold-text-gradient">DHEA 2026?</span>
        </h3>
        <p class="max-w-2xl mx-auto text-xs sm:text-sm text-[#c9b8a3]">
          Competing in India's premier healthcare awards delivers enduring organizational prestige, market distinction, and patient confidence.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {whyEnterPoints.map((item, idx) => (
          <div class="glass-card rounded-2xl p-6 border border-[#d4a34b]/20 bg-[#161009]/80 flex gap-4 items-start group hover:border-[#d4a34b]/60">
            <div class="w-9 h-9 rounded-xl bg-[#2e1f0e] border border-[#d4a34b]/30 flex items-center justify-center text-xs font-bold text-[#f6dd9f] shrink-0 mt-0.5 group-hover:bg-[#d4a34b] group-hover:text-black transition-colors">
              0{idx + 1}
            </div>
            <div>
              <h4 class="font-serif text-base sm:text-lg font-bold text-white mb-1.5 group-hover:text-[#f6dd9f] transition-colors">
                {item.title}
              </h4>
              <p class="text-xs sm:text-sm text-[#bdae9c] leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<div class="gold-divider my-10"></div>
