---
import config from '../data/config.json';
const { site, contact, forms } = config;
const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || forms?.web3formsAccessKey || '';
---

<section id="contact" class="relative py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="section-badge">Get In Touch</div>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-4">
        Contact <span class="gold-text-gradient">Secretariat</span>
      </h2>
      <p class="max-w-2xl mx-auto text-sm sm:text-base text-[#c9b8a3]">
        Connect with the {site.name} Awards Organizing Committee for nomination support, delegate registrations, and partnership inquiries.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left Column: Secretariat Information -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="glass-card rounded-3xl p-8 border border-[#d4a34b]/30 bg-gradient-to-b from-[#1c130a] to-[#120d08] shadow-xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#2e1f0e] border border-[#d4a34b]/30 text-xs font-bold text-[#f6dd9f] uppercase tracking-wider mb-4">
            Official Secretariat
          </div>

          <h3 class="font-serif text-2xl font-bold text-white mb-1">
            {contact.secretariatName}
          </h3>
          <p class="text-xs sm:text-sm font-medium text-[#d4a34b] mb-6">
            {contact.organization}
          </p>

          <div class="space-y-5 text-xs sm:text-sm text-[#ded1be]">
            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-[#2b1c0e] border border-[#d4a34b]/30 flex items-center justify-center p-2.5 text-[#f6dd9f] shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <span class="block text-[11px] uppercase tracking-wider text-[#9a866f]">Email Inquiries</span>
                <a href={`mailto:${contact.primaryEmail}`} class="font-semibold text-white hover:text-[#f6dd9f] transition-colors">
                  {contact.primaryEmail}
                </a>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-[#2b1c0e] border border-[#d4a34b]/30 flex items-center justify-center p-2.5 text-[#f6dd9f] shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <span class="block text-[11px] uppercase tracking-wider text-[#9a866f]">Helpline & WhatsApp</span>
                <span class="font-semibold text-white">{contact.helpline}</span>
                <p class="text-[11px] text-[#9a866f]">{contact.operatingHours}</p>
              </div>
            </div>

            <!-- Website -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-[#2b1c0e] border border-[#d4a34b]/30 flex items-center justify-center p-2.5 text-[#f6dd9f] shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
              </div>
              <div>
                <span class="block text-[11px] uppercase tracking-wider text-[#9a866f]">Official Website</span>
                <a href={contact.website} target="_blank" class="font-semibold text-white hover:text-[#f6dd9f] transition-colors">
                  {contact.websiteDisplay}
                </a>
              </div>
            </div>

            <!-- Location -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-[#2b1c0e] border border-[#d4a34b]/30 flex items-center justify-center p-2.5 text-[#f6dd9f] shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <span class="block text-[11px] uppercase tracking-wider text-[#9a866f]">Host City & Venue</span>
                <span class="font-semibold text-white">{site.venue || contact.address}</span>
                <p class="text-[11px] text-[#9a866f]">Grand Conclave & Awards Ceremony ({site.eventDateDisplay})</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Help Note -->
        <div class="p-6 rounded-2xl bg-[#140e08]/90 border border-[#d4a34b]/20 text-xs text-[#bdae9c]">
          <p class="font-bold text-[#f6dd9f] mb-1">Nomination Assistance Desk</p>
          <p>Need support choosing your award category or uploading clinical audit documents? Reach out to our dedicated advisory desk.</p>
        </div>
      </div>

      <!-- Right Column: Interactive Contact Form -->
      <div class="lg:col-span-7">
        <div class="glass-card rounded-3xl p-8 sm:p-10 border border-[#d4a34b]/30 bg-gradient-to-b from-[#181109] to-[#110d08] shadow-xl">
          <h3 class="font-serif text-2xl font-bold text-white mb-2">
            Send Secretariat an Inquiry
          </h3>
          <p class="text-xs sm:text-sm text-[#bdae9c] mb-6">
            Fill out the form below. Our awards coordinator will revert within 24 business hours.
          </p>

          <form id="contact-form" class="space-y-4">
            <!-- Anti-spam Honeypot -->
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-[#f6dd9f] uppercase tracking-wider mb-1.5">
                  Full Name *
                </label>
                <input 
                  type="text" 
                  name="name"
                  required
                  placeholder="Dr. / Mr. / Ms. Full Name"
                  class="w-full px-4 py-3 rounded-xl bg-[#20150b] border border-[#d4a34b]/25 text-white placeholder-[#786754] text-xs focus:outline-none focus:border-[#d4a34b] transition-colors"
                />
              </div>

              <div>
                <label class="block text-xs font-semibold text-[#f6dd9f] uppercase tracking-wider mb-1.5">
                  Official Email *
                </label>
                <input 
                  type="email" 
                  name="email"
                  required
                  placeholder="name@organization.com"
                  class="w-full px-4 py-3 rounded-xl bg-[#20150b] border border-[#d4a34b]/25 text-white placeholder-[#786754] text-xs focus:outline-none focus:border-[#d4a34b] transition-colors"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-[#f6dd9f] uppercase tracking-wider mb-1.5">
                  Mobile Number *
                </label>
                <input 
                  type="tel" 
                  name="phone"
                  required
                  placeholder="+91 98765 43210"
                  class="w-full px-4 py-3 rounded-xl bg-[#20150b] border border-[#d4a34b]/25 text-white placeholder-[#786754] text-xs focus:outline-none focus:border-[#d4a34b] transition-colors"
                />
              </div>

              <div>
                <label class="block text-xs font-semibold text-[#f6dd9f] uppercase tracking-wider mb-1.5">
                  Organization / Hospital Name *
                </label>
                <input 
                  type="text" 
                  name="organization"
                  required
                  placeholder="Hospital, Pharma or Company Name"
                  class="w-full px-4 py-3 rounded-xl bg-[#20150b] border border-[#d4a34b]/25 text-white placeholder-[#786754] text-xs focus:outline-none focus:border-[#d4a34b] transition-colors"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-[#f6dd9f] uppercase tracking-wider mb-1.5">
                Inquiry Type *
              </label>
              <select 
                name="inquiry_type"
                class="w-full px-4 py-3 rounded-xl bg-[#20150b] border border-[#d4a34b]/25 text-white text-xs focus:outline-none focus:border-[#d4a34b] transition-colors"
              >
                <option value="Award Nomination Assistance">Award Nomination Assistance</option>
                <option value="Delegate Registration & Table Booking">Delegate Registration & Table Booking</option>
                <option value="Sponsorship & Partnership Package">Sponsorship & Partnership Package</option>
                <option value="Jury or Academic Collaboration">Jury or Academic Collaboration</option>
                <option value="Media & Press Accreditation">Media & Press Accreditation</option>
                <option value="General Secretariat Query">General Secretariat Query</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-[#f6dd9f] uppercase tracking-wider mb-1.5">
                Message / Queries *
              </label>
              <textarea 
                rows="4"
                name="message"
                required
                placeholder="Please outline your queries regarding nominations, delegate passes, or sponsorship..."
                class="w-full px-4 py-3 rounded-xl bg-[#20150b] border border-[#d4a34b]/25 text-white placeholder-[#786754] text-xs focus:outline-none focus:border-[#d4a34b] transition-colors resize-none"
              ></textarea>
            </div>

            <button 
              id="contact-submit-btn"
              type="submit"
              class="btn-gold w-full py-4 rounded-xl text-xs font-bold tracking-wider cursor-pointer shadow-gold-glow flex items-center justify-center transition-all disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="contact-submit-text">Submit Message to Secretariat</span>
            </button>

            <div id="contact-success" class="hidden p-4 rounded-xl bg-emerald-950/80 border border-emerald-500/50 text-emerald-300 text-xs text-center leading-relaxed">
              ✓ Thank you! Your message has been routed to DHEA Secretariat ({contact.primaryEmail}). We will get back to you shortly.
            </div>

            <div id="contact-error" class="hidden p-4 rounded-xl bg-red-950/80 border border-red-500/50 text-red-300 text-xs text-center leading-relaxed">
            </div>
          </form>
        </div>
      </div>

    </div>

  </div>
</section>

<script define:vars={{ web3formsKey: web3formsAccessKey, primaryEmail: contact.primaryEmail, siteName: site.name }}>
  const contactForm = document.getElementById('contact-form');
  const successBox = document.getElementById('contact-success');
  const errorBox = document.getElementById('contact-error');
  const submitBtn = document.getElementById('contact-submit-btn');
  const originalBtnText = submitBtn ? submitBtn.innerHTML : 'Submit Message to Secretariat';

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (successBox) successBox.classList.add('hidden');
    if (errorBox) errorBox.classList.add('hidden');

    const formData = new FormData(contactForm);

    // Bot honeypot check
    if (formData.get('botcheck')) {
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <span class="inline-flex items-center gap-2">
          <svg class="animate-spin h-4 w-4 text-black" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Sending Message to Secretariat...
        </span>
      `;
    }

    try {
      const payload = {
        subject: `[${siteName}] Secretariat Inquiry from ${formData.get('name') || 'Website Visitor'}`,
        from_name: `${siteName} Awards Secretariat`,
        ...Object.fromEntries(formData.entries())
      };

      if (!web3formsKey) {
        // Simulation mode when no key is set yet
        console.warn(`[Web3Forms] No access key configured. Form submission simulated. Configure forms.web3formsAccessKey in config.json or PUBLIC_WEB3FORMS_KEY in .env to receive real emails at ${primaryEmail}`);
        await new Promise((r) => setTimeout(r, 650));
        if (successBox) {
          successBox.innerHTML = `✓ Thank you! Your message has been received.<br><span class="text-[11px] text-[#f6dd9f] mt-1 block">Recipient: ${primaryEmail}</span><span class="opacity-80 text-[10px] mt-0.5 block">(Demo mode: Set your Web3Forms Access Key in config.json or .env to receive actual emails)</span>`;
          successBox.classList.remove('hidden');
        }
        contactForm.reset();
      } else {
        payload.access_key = web3formsKey;
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (response.ok && data.success) {
          if (successBox) {
            successBox.innerHTML = `✓ Thank you! Your message has been routed to DHEA Secretariat (${primaryEmail}). We will get back to you shortly.`;
            successBox.classList.remove('hidden');
          }
          contactForm.reset();
        } else {
          throw new Error(data.message || 'Failed to submit form. Please verify your details.');
        }
      }
    } catch (err) {
      if (errorBox) {
        errorBox.textContent = err.message || `Unable to send message right now. Please email us directly at ${primaryEmail}.`;
        errorBox.classList.remove('hidden');
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnText;
      }
    }
  });
</script>
