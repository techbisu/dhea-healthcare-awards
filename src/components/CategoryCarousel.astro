---
import awardData from '../data/awardCategories.json';

const { tracks, totalAwards, totalTracks, edition } = awardData;
---

<section id="categories" class="relative py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-10">
      <div class="section-badge inline-flex items-center gap-1.5">
        <span>🏆</span>
        <span>{totalTracks} Healthcare Sectors • {totalAwards}+ Subcategories</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-3">
        Award <span class="gold-text-gradient">Categories & Verticals</span>
      </h2>
      <p class="max-w-2xl mx-auto text-sm sm:text-base text-[#c9b8a3]">
        DHEA {edition} celebrates breakthrough milestones across 15 distinct medical domains. Browse flagship tracks below or explore the full interactive directory.
      </p>
    </div>

    <!-- Carousel Wrapper with Navigation Arrows -->
    <div class="relative group/carousel">
      <!-- Prev Button -->
      <button
        id="carousel-prev"
        type="button"
        aria-label="Previous category"
        class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-[#1e1309]/90 border border-[#d4a34b]/60 text-[#f6dd9f] hover:bg-[#d4a34b] hover:text-black transition-all duration-300 flex items-center justify-center shadow-gold-glow cursor-pointer backdrop-blur-md"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Track Cards Carousel Rail -->
      <div
        id="category-carousel-rail"
        class="flex gap-5 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-4 pt-1 px-1 scrollbar-none"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {tracks.map((track) => {
          const sampleAwards = track.awards.slice(0, 2);
          return (
            <div
              class="w-[85vw] sm:w-[340px] md:w-[370px] shrink-0 snap-start glass-card rounded-2xl p-6 border border-[#d4a34b]/30 bg-gradient-to-b from-[#181109]/95 to-[#100a06]/95 hover:border-[#d4a34b] transition-all duration-300 flex flex-col justify-between group shadow-xl hover:shadow-[0_10px_30px_rgba(212,163,75,0.18)]"
            >
              <div>
                <!-- Top Badge & Icon -->
                <div class="flex items-center justify-between gap-3 mb-4">
                  <div class="w-12 h-12 rounded-xl bg-[#26190c] border border-[#d4a34b]/40 flex items-center justify-center text-2xl shadow-inner group-hover:scale-110 transition-transform">
                    {track.icon}
                  </div>
                  <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-[#24170a] text-[#f6dd9f] border border-[#d4a34b]/30">
                    {track.badge || `${track.awards.length} Awards`}
                  </span>
                </div>

                <!-- Track Title & Description -->
                <h3 class="font-serif text-lg sm:text-xl font-bold text-white mb-2 group-hover:text-[#f6dd9f] transition-colors">
                  {track.name}
                </h3>
                <p class="text-xs text-[#bdae9c] leading-relaxed mb-4 line-clamp-2">
                  {track.description}
                </p>

                <!-- Sample Award Chips -->
                <div class="space-y-1.5 mb-5 pt-3 border-t border-[#2e2012]">
                  <span class="text-[10px] font-semibold text-[#8f7e6a] uppercase tracking-wider block">
                    Sample Subcategories:
                  </span>
                  {sampleAwards.map((a) => (
                    <div class="flex items-center gap-1.5 text-[11px] text-[#e0cfb8] truncate">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#d4a34b] shrink-0"></span>
                      <span class="font-mono text-[#d4a34b] text-[10px]">[{a.code}]</span>
                      <span class="truncate">{a.name}</span>
                    </div>
                  ))}
                  {track.awards.length > 2 && (
                    <div class="text-[10px] text-[#a8957e] italic pt-0.5">
                      + {track.awards.length - 2} more award subcategories
                    </div>
                  )}
                </div>
              </div>

              <!-- Action Link -->
              <a
                href={`/categories?track=${track.id}`}
                class="w-full py-2.5 px-4 rounded-xl text-xs font-semibold text-center border border-[#d4a34b]/40 bg-[#211409] text-[#f6dd9f] hover:bg-[#d4a34b] hover:text-black transition-all duration-300 flex items-center justify-center gap-1.5 cursor-pointer"
              >
                <span>View {track.shortName || track.name}</span>
                <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          );
        })}
      </div>

      <!-- Next Button -->
      <button
        id="carousel-next"
        type="button"
        aria-label="Next category"
        class="absolute -right-3 sm:-right-5 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-[#1e1309]/90 border border-[#d4a34b]/60 text-[#f6dd9f] hover:bg-[#d4a34b] hover:text-black transition-all duration-300 flex items-center justify-center shadow-gold-glow cursor-pointer backdrop-blur-md"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Carousel Indicators (Dots) -->
    <div id="carousel-dots" class="flex items-center justify-center gap-1.5 mt-5">
      {tracks.map((_, i) => (
        <button
          type="button"
          data-index={i}
          aria-label={`Go to slide ${i + 1}`}
          class={`carousel-dot transition-all duration-300 rounded-full h-1.5 ${
            i === 0 ? 'w-6 bg-[#d4a34b]' : 'w-2 bg-[#422c16] hover:bg-[#855e2d]'
          }`}
        />
      ))}
    </div>

    <!-- Bottom CTA Bar -->
    <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-[#20150b] via-[#2a1c0d] to-[#20150b] border border-[#d4a34b]/40 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div>
        <div class="text-xs uppercase font-bold tracking-widest text-[#d4a34b] mb-1">Full 200+ Category Directory</div>
        <h4 class="font-serif text-xl sm:text-2xl font-bold text-white mb-2">
          Searching for a specific specialty or nomination level?
        </h4>
        <p class="text-xs sm:text-sm text-[#c9b8a3] max-w-2xl">
          Search all 211 subcategories by keyword, filter by National vs. Regional honor, and download the official 2026–2027 Category Handbook.
        </p>
      </div>

      <a
        href="/categories"
        class="btn-gold px-7 py-3.5 rounded-xl text-xs sm:text-sm font-bold tracking-wider shrink-0 cursor-pointer shadow-gold-glow flex items-center gap-2 hover:scale-105 transition-all"
      >
        <span>Explore All 200+ Categories</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const rail = document.getElementById('category-carousel-rail');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const dots = document.querySelectorAll('.carousel-dot');

    if (!rail) return;

    function getCardWidth() {
      const card = rail?.querySelector('.snap-start') as HTMLElement;
      if (!card) return 360;
      const gap = 20; // 20px (gap-5)
      return card.offsetWidth + gap;
    }

    function scrollNext() {
      const cardWidth = getCardWidth();
      const maxScroll = rail.scrollWidth - rail.clientWidth;
      if (rail.scrollLeft >= maxScroll - 10) {
        rail.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        rail.scrollBy({ left: cardWidth, behavior: 'smooth' });
      }
    }

    function scrollPrev() {
      const cardWidth = getCardWidth();
      if (rail.scrollLeft <= 10) {
        rail.scrollTo({ left: rail.scrollWidth, behavior: 'smooth' });
      } else {
        rail.scrollBy({ left: -cardWidth, behavior: 'smooth' });
      }
    }

    nextBtn?.addEventListener('click', () => {
      stopAutoScroll();
      scrollNext();
      startAutoScroll();
    });

    prevBtn?.addEventListener('click', () => {
      stopAutoScroll();
      scrollPrev();
      startAutoScroll();
    });

    // Update active dot on scroll
    function updateActiveDot() {
      const cardWidth = getCardWidth();
      const activeIndex = Math.round(rail.scrollLeft / cardWidth);
      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.add('w-6', 'bg-[#d4a34b]');
          dot.classList.remove('w-2', 'bg-[#422c16]');
        } else {
          dot.classList.remove('w-6', 'bg-[#d4a34b]');
          dot.classList.add('w-2', 'bg-[#422c16]');
        }
      });
    }

    rail.addEventListener('scroll', updateActiveDot, { passive: true });

    // Click dot to jump
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        const cardWidth = getCardWidth();
        rail.scrollTo({ left: idx * cardWidth, behavior: 'smooth' });
      });
    });

    // Auto-scroll every 4.5 seconds
    let autoScrollInterval: ReturnType<typeof setInterval> | null = null;

    function startAutoScroll() {
      if (autoScrollInterval) clearInterval(autoScrollInterval);
      autoScrollInterval = setInterval(() => {
        scrollNext();
      }, 4500);
    }

    function stopAutoScroll() {
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval);
        autoScrollInterval = null;
      }
    }

    rail.addEventListener('mouseenter', stopAutoScroll);
    rail.addEventListener('mouseleave', startAutoScroll);
    rail.addEventListener('touchstart', stopAutoScroll, { passive: true });
    rail.addEventListener('touchend', startAutoScroll);

    startAutoScroll();
  });
</script>
