    id: "pharma",
    name: "Pharma & Biotech",
    icon: "💊",
    awards: [
      { name: "Pharmaceutical Company of the Year", level: "National", code: "PHA-01" },
      { name: "Excellence in Novel Drug Delivery & Formulation", level: "National", code: "PHA-02" },
      { name: "Biotech Innovator of the Year", level: "National", code: "PHA-03" },
      { name: "Excellence in Vaccine Development & Supply Chain", level: "National", code: "PHA-04" },
