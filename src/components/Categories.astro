      { name: "Best Multi-Specialty Hospital (Regional: East, West, North, South)", level: "Regional", code: "HOS-02" },
      { name: "Best Single-Specialty Hospital (Cardiology / Oncology / Ortho / Neuro)", level: "National", code: "HOS-03" },
      { name: "Excellence in Patient Safety & Clinical Outcomes", level: "National", code: "HOS-04" },
