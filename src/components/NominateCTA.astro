---
---

<section id="nominate" class="relative py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Badge -->
    <div class="text-center mb-12">
      <div class="section-badge">Take Part in DHEA 2026</div>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-4">
        Recognize <span class="gold-text-gradient">Healthcare Excellence</span>
      </h2>
      <p class="max-w-2xl mx-auto text-sm sm:text-base text-[#c9b8a3]">
        Whether applying for an award or joining as an esteemed delegate, experience India's grandest healthcare celebratory evening.
      </p>
    </div>

    <!-- Dual Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Card 1: Nominate Now -->
      <div class="relative glass-card rounded-3xl p-8 sm:p-12 border-2 border-[#d4a34b]/40 bg-gradient-to-br from-[#1d140a]/95 via-[#140e08]/95 to-[#0e0a06]/95 overflow-hidden flex flex-col justify-between group hover:border-[#d4a34b] transition-all duration-300 shadow-[0_10px_40px_rgba(212,163,75,0.15)]">
        <!-- Ambient gold glow -->
        <div class="absolute -top-12 -right-12 w-48 h-48 bg-[#d4a34b]/15 rounded-full blur-3xl pointer-events-none"></div>

        <div>
          <!-- Header tag -->
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-[#352411] text-[#f6dd9f] border border-[#d4a34b]/30">
              For Nominees
            </span>
            <span class="text-xs font-semibold text-emerald-400 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
              Portal Open
            </span>
          </div>

          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#f6dd9f] via-[#d4a34b] to-[#784d12] p-[2px] mb-6 shadow-md">
            <div class="w-full h-full bg-[#120d08] rounded-[14px] flex items-center justify-center">
              <svg class="w-8 h-8 text-[#f6dd9f]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
              </svg>
            </div>
          </div>

          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-3">
            Nominate Now
          </h3>

          <p class="text-sm sm:text-base text-[#d8c8b4] leading-relaxed mb-6">
            Recognize your achievements and compete for India's most prestigious healthcare awards.
          </p>

          <div class="space-y-2 mb-8">
            <div class="flex items-center gap-2 text-xs sm:text-sm text-[#bdae9c]">
              <svg class="w-4 h-4 text-[#d4a34b]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>100+ National & Regional Categories</span>
            </div>
            <div class="flex items-center gap-2 text-xs sm:text-sm text-[#bdae9c]">
              <svg class="w-4 h-4 text-[#d4a34b]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>Confidential & Peer Reviewed Evaluation</span>
            </div>
            <div class="flex items-center gap-2 text-xs sm:text-sm text-[#bdae9c]">
              <svg class="w-4 h-4 text-[#d4a34b]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>Early Bird benefit available until 15 August 2026</span>
            </div>
          </div>
        </div>

        <div>
          <button 
            type="button"
            onclick="window.openModal('modal-nominate')"
            class="btn-gold w-full py-4 rounded-xl text-sm font-bold tracking-wider flex items-center justify-center gap-2 cursor-pointer shadow-gold-glow"
          >
            <span>Apply for Awards →</span>
          </button>
        </div>
      </div>

      <!-- Card 2: Register as Delegate -->
      <div class="relative glass-card rounded-3xl p-8 sm:p-12 border border-[#d4a34b]/30 bg-gradient-to-br from-[#1a120a]/95 via-[#120d08]/95 to-[#0b0805]/95 overflow-hidden flex flex-col justify-between group hover:border-[#d4a34b]/70 transition-all duration-300">
        <!-- Ambient gold glow -->
        <div class="absolute -top-12 -right-12 w-48 h-48 bg-[#9e6d19]/15 rounded-full blur-3xl pointer-events-none"></div>

        <div>
          <!-- Header tag -->
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-[#2a1d0d] text-[#e8dac7] border border-[#d4a34b]/20">
              For Attendees & Leaders
            </span>
            <span class="text-xs font-semibold text-[#f6dd9f]">
              December 2026 | Kolkata
            </span>
          </div>

          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#f6dd9f] via-[#d4a34b] to-[#784d12] p-[2px] mb-6 shadow-md">
            <div class="w-full h-full bg-[#120d08] rounded-[14px] flex items-center justify-center">
              <svg class="w-8 h-8 text-[#f6dd9f]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
              </svg>
            </div>
          </div>

          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-3">
            Register as Delegate
          </h3>

          <p class="text-sm sm:text-base text-[#d8c8b4] leading-relaxed mb-6">
            Attend the awards ceremony, network with industry leaders, and celebrate healthcare excellence.
          </p>

          <div class="space-y-2 mb-8">
            <div class="flex items-center gap-2 text-xs sm:text-sm text-[#bdae9c]">
              <svg class="w-4 h-4 text-[#d4a34b]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>1000+ C-Suite Healthcare Decision Makers</span>
            </div>
            <div class="flex items-center gap-2 text-xs sm:text-sm text-[#bdae9c]">
              <svg class="w-4 h-4 text-[#d4a34b]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>Keynote Conclave, Panel Discussions & Gala Dinner</span>
            </div>
            <div class="flex items-center gap-2 text-xs sm:text-sm text-[#bdae9c]">
              <svg class="w-4 h-4 text-[#d4a34b]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>Access to Exclusive Networking Lounge</span>
            </div>
          </div>
        </div>

        <div>
          <button 
            type="button"
            onclick="window.openModal('modal-delegate')"
            class="btn-outline-gold w-full py-4 rounded-xl text-sm font-bold tracking-wider flex items-center justify-center gap-2 cursor-pointer hover:bg-[#d4a34b]/20"
          >
            <span>Book Your Seat →</span>
          </button>
        </div>
      </div>

    </div>

  </div>
</section>

<div class="gold-divider my-10"></div>
