---
import config from '../data/config.json';
const { site, contact, dates } = config;

const menuStructure = [
  { name: 'Home', href: '/#banner' },
  { 
    name: 'About', 
    href: '/#about',
    subitems: [
      { name: `About ${site.name}`, href: '/#about', desc: 'Mission, vision & overview' },
      { name: 'Why Enter DHEA?', href: '/#why-enter', desc: 'Prestigious industry recognition' },
      { name: 'Who Should Enter?', href: '/#who-should-enter', desc: 'Eligible sectors & organizations' },
    ]
  },
  { name: 'Categories', href: '/#categories' },
  { name: 'Jury', href: '/#jury' },
  { 
    name: 'Nomination & Process', 
    href: '/#nominate',
    subitems: [
      { name: 'Nominate Now', href: '/#nominate', desc: 'Apply for prestigious awards' },
      { name: 'Judging Process', href: '/#judging-process', desc: 'Multi-tiered scoring matrix' },
      { name: 'Entry Guidelines', href: '/#guidelines', desc: 'Rules, dates & eligibility' },
    ]
  },
  { name: 'Sponsorship', href: '/#sponsorship' },
  { 
    name: 'More', 
    href: '/#faq',
    subitems: [
      { name: 'FAQ', href: '/#faq', desc: 'Frequently asked questions' },
      { name: 'News & Updates', href: '/#news', desc: 'Press releases & announcements' },
      { name: 'Media & Partners', href: '/#partners', desc: 'Official institutional partners' },
    ]
  },
  { name: 'Contact', href: '/#contact' },
];
---

<header class="sticky top-0 z-50 transition-all duration-300 backdrop-blur-md bg-[#0c0906]/95 border-b border-[#d4a34b]/20">
  <!-- Top ticker / notification bar -->
  <div class="hidden md:flex justify-between items-center px-4 sm:px-8 py-1.5 text-xs bg-[#161009] border-b border-[#d4a34b]/15 text-[#e5d4bc]">
    <div class="flex items-center gap-4">
      <span class="inline-flex items-center gap-1.5 text-[#f6dd9f] font-semibold">
        <span class="w-2 h-2 rounded-full bg-[#d4a34b] animate-ping"></span>
        {site.name}
      </span>
      <span class="text-[#c5b59f]">{site.eventDateDisplay} | {site.locationDisplay}</span>
      <span class="text-[#8c5e15]">|</span>
      <span class="text-[#f6dd9f]">Early Bird Deadline: {dates.earlyBirdDeadline}</span>
    </div>
    <div class="flex items-center gap-4">
      <a href={`mailto:${contact.primaryEmail}`} class="hover:text-[#f6dd9f] transition-colors flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-[#d4a34b]" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
        </svg>
        {contact.primaryEmail}
      </a>
      <span class="text-[#8c5e15]">|</span>
      <a href={contact.website} target="_blank" class="hover:text-[#f6dd9f] transition-colors">{contact.websiteDisplay}</a>
    </div>
  </div>

  <!-- Main Navigation inside standard container max-w-7xl -->
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/#banner" class="flex items-center gap-3 shrink-0 group">
      <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-[#f6dd9f] via-[#d4a34b] to-[#7a4c0e] p-[1.5px] shadow-[0_0_15px_rgba(212,163,75,0.4)] shrink-0">
        <div class="w-full h-full bg-[#110d08] rounded-[7px] flex items-center justify-center">
          <!-- Award Trophy Caduceus Icon -->
          <svg class="w-5 h-5 text-[#f6dd9f]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
            <path d="M4 22h16"/>
            <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
            <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
            <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
          </svg>
        </div>
      </div>
      <div>
        <div class="font-serif font-black tracking-widest text-base sm:text-lg text-transparent bg-clip-text bg-gradient-to-r from-[#fff2cc] via-[#f6dd9f] to-[#d4a34b] leading-tight whitespace-nowrap">
          {site.name}
        </div>
        <div class="text-[9px] sm:text-[10px] font-semibold tracking-wider text-[#d5c3aa] uppercase whitespace-nowrap">
          {site.fullName}
        </div>
      </div>
    </a>

    <!-- Desktop Menu Links with Submenus - Fits Cleanly In One Line -->
    <div class="hidden lg:flex items-center gap-1 xl:gap-1.5 shrink-0">
      {menuStructure.map((item) => (
        <div class="relative group">
          {item.subitems ? (
            <div class="inline-flex items-center">
              <a 
                href={item.href}
                class="px-2.5 xl:px-3 py-2 text-[13px] font-medium tracking-wide text-[#e8dac7] hover:text-[#f6dd9f] hover:bg-[#251b10] rounded-lg whitespace-nowrap transition-all duration-200 flex items-center gap-1 group-hover:text-[#f6dd9f]"
              >
                <span>{item.name}</span>
                <svg class="w-3.5 h-3.5 text-[#d4a34b] transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </a>

              <!-- Submenu Dropdown Container -->
              <div class="absolute top-full left-0 pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-1.5 z-50">
                <div class="bg-[#140e08]/98 border border-[#d4a34b]/30 rounded-2xl p-2 shadow-[0_15px_35px_rgba(0,0,0,0.85)] backdrop-blur-xl">
                  {item.subitems.map((sub) => (
                    <a 
                      href={sub.href}
                      class="block px-3 py-2.5 rounded-xl hover:bg-[#251b10] transition-colors group/sub"
                    >
                      <div class="text-xs font-semibold text-[#f3ede2] group-hover/sub:text-[#f6dd9f] transition-colors flex items-center justify-between">
                        <span>{sub.name}</span>
                        <span class="text-[#d4a34b] opacity-0 group-hover/sub:opacity-100 transition-opacity">→</span>
                      </div>
                      <div class="text-[10px] text-[#9a866f] mt-0.5">
                        {sub.desc}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a 
              href={item.href}
              class="px-2.5 xl:px-3 py-2 text-[13px] font-medium tracking-wide text-[#e8dac7] hover:text-[#f6dd9f] hover:bg-[#251b10] rounded-lg whitespace-nowrap transition-all duration-200 inline-block"
            >
              {item.name}
            </a>
          )}
        </div>
      ))}
    </div>

    <!-- Right Action Button -->
    <div class="hidden sm:flex items-center gap-3 shrink-0">
      <button 
        type="button"
        onclick="window.openModal('modal-nominate')"
        class="btn-gold px-4 xl:px-5 py-2.5 rounded-xl text-xs font-bold tracking-wider whitespace-nowrap shadow-md hover:shadow-gold-glow cursor-pointer"
      >
        Nominate Now
      </button>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button 
      id="mobile-menu-btn"
      type="button" 
      class="lg:hidden p-2 text-[#e5bd75] hover:text-[#fff] hover:bg-[#22180f] rounded-lg transition-colors"
      aria-label="Toggle Navigation Menu"
    >
      <svg id="menu-icon-bars" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#110d08]/98 border-b border-[#d4a34b]/20 px-6 py-6 transition-all duration-300 max-h-[80vh] overflow-y-auto">
    <div class="flex flex-col gap-2">
      {menuStructure.map((item) => (
        <div>
          {item.subitems ? (
            <div class="border-b border-[#251b10] pb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-[#d4a34b] block py-1.5">
                {item.name}
              </span>
              <div class="pl-2 flex flex-col gap-1">
                {item.subitems.map((sub) => (
                  <a 
                    href={sub.href}
                    class="mobile-nav-link text-sm font-medium text-[#e8dac7] hover:text-[#f6dd9f] py-1 transition-colors flex items-center justify-between"
                  >
                    <span>{sub.name}</span>
                    <span class="text-xs text-[#8c5e15]">›</span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a 
              href={item.href}
              class="mobile-nav-link text-sm font-medium text-[#e8dac7] hover:text-[#f6dd9f] py-2 border-b border-[#251b10] transition-colors block"
            >
              {item.name}
            </a>
          )}
        </div>
      ))}
      <div class="pt-4 flex flex-col gap-2">
        <button 
          type="button"
          onclick="window.openModal('modal-nominate'); document.getElementById('mobile-menu').classList.add('hidden');"
          class="btn-gold w-full py-3 rounded-xl text-center text-xs font-bold tracking-wider"
        >
          Nominate Now
        </button>
        <button 
          type="button"
          onclick="window.openModal('modal-brochure'); document.getElementById('mobile-menu').classList.add('hidden');"
          class="btn-outline-gold w-full py-3 rounded-xl text-center text-xs font-bold tracking-wider"
        >
          Download Brochure
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconBars = document.getElementById('menu-icon-bars');
  const iconClose = document.getElementById('menu-icon-close');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    iconBars?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  document.querySelectorAll('.mobile-nav-link').forEach((el) => {
    el.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      iconBars?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
