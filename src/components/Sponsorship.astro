---
import config from '../data/config.json';
const sponsorshipDoc = config.downloads.sponsorshipBrochure;
const reasons = [
  {
    title: "Brand Visibility",
    desc: "Unprecedented multi-channel national branding across digital, print, stage backdrops, and broadcast media.",
    icon: `<svg class="w-6 h-6 text-[#f6dd9f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>`
  },
  {
    title: "Healthcare Decision Makers",
    desc: "Direct, high-impact engagement with C-suite executives, hospital owners, procurement chiefs, and clinical heads.",
    icon: `<svg class="w-6 h-6 text-[#f6dd9f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`
  },
  {
    title: "Media Coverage",
    desc: "National press release coverage, video interviews, social media amplification to over 500,000+ medical community followers.",
    icon: `<svg class="w-6 h-6 text-[#f6dd9f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>`
  },
  {
    title: "Networking",
    desc: "Exclusive access to VIP CXO roundtables, private luncheons, and dedicated 1-on-1 business matchmaking zones.",
    icon: `<svg class="w-6 h-6 text-[#f6dd9f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`
  },
  {
    title: "Exhibition Opportunities",
    desc: "Prime showcase booths in the grand networking hall to demonstrate innovative medical technologies, devices, and products.",
    icon: `<svg class="w-6 h-6 text-[#f6dd9f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>`
  }
];

const packages = [
  {
    name: "Title Sponsor",
    tagline: "Exclusive naming rights & maximum brand authority",
    highlight: true,
    badge: "1 Exclusive Partner",
    features: [
      "Prefix branding: 'DHEA 2026 Presented by [Your Brand]'",
      "Keynote speaking address during the opening ceremony",
      "VIP dais seated seat & award presentation by your leadership",
      "Prime 36 sq.m premium exhibition pavilion",
      "15 VIP Delegate & Gala Dinner passes",
      "Full-page double spread advertisement in official DHEA Souvenir"
    ]
  },
  {
    name: "Powered By Sponsor",
    tagline: "High-tier co-branding and stage prominence",
    highlight: false,
    badge: "2 Positions Available",
    features: [
      "Co-branding: 'DHEA 2026 Powered by [Your Brand]'",
      "Panel moderator / panelist seat in the CEO Healthcare Conclave",
      "Award presentation for 3 top marquee categories",
      "18 sq.m prime exhibition space",
      "10 VIP Delegate passes",
      "Full page color advertisement in DHEA Souvenir"
    ]
  },
  {
    name: "Associate Sponsor",
    tagline: "Strong institutional presence and targeted exposure",
    highlight: false,
    badge: "Limited Slots",
    features: [
      "Associate branding across all marketing collaterals and website",
      "Award presentation for 2 award categories",
      "9 sq.m exhibition space",
      "6 VIP Delegate passes",
      "Half page color advertisement in DHEA Souvenir",
      "Logo on official event bags & badges"
    ]
  },
  {
    name: "Category Sponsor",
    tagline: "Own a specific domain or sector award category",
    highlight: false,
    badge: "Sector Focused",
    features: [
      "Exclusive naming of selected award category",
      "Category trophy hand-over by your executive",
      "Logo branding on category video screens & stage",
      "4 Delegate passes",
      "Quarter page color feature in DHEA Souvenir"
    ]
  },
  {
    name: "Supporting Partner",
    tagline: "Connect with the healthcare ecosystem at accessible scale",
    highlight: false,
    badge: "Ecosystem Partner",
    features: [
      "Logo presence on website, event brochure, and stage backdrop",
      "2 Delegate passes to the awards gala and conference",
      "Mention in official press releases",
      "Distribution of marketing materials in delegate kit"
    ]
  }
];
---

<section id="sponsorship" class="relative py-20 px-4 sm:px-6 lg:px-8 bg-[#100c08]/50">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="section-badge">Partnership Opportunities</div>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-4">
        Sponsorship & <span class="gold-text-gradient">Brand Alliances</span>
      </h2>
      <p class="max-w-2xl mx-auto text-sm sm:text-base text-[#c9b8a3]">
        Position your brand at the forefront of Indian healthcare innovation before 1000+ healthcare leaders, hospital conglomerates, and medical visionaries.
      </p>
    </div>

    <!-- Why Sponsor DHEA Section -->
    <div class="mb-20">
      <div class="text-center mb-10">
        <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-2">
          Why Sponsor <span class="gold-text-gradient">DHEA 2026?</span>
        </h3>
        <p class="text-xs sm:text-sm text-[#c9b8a3]">Key value propositions for corporate partners</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {reasons.map((r, idx) => (
          <div class="glass-card rounded-2xl p-5 border border-[#d4a34b]/20 bg-[#161009]/80 text-center flex flex-col items-center justify-between group hover:border-[#d4a34b]/60">
            <div>
              <div class="w-12 h-12 rounded-xl bg-[#26190c] border border-[#d4a34b]/30 flex items-center justify-center p-2.5 mb-4 group-hover:scale-110 transition-transform shadow-inner" set:html={r.icon} />
              <h4 class="font-serif text-base font-bold text-white mb-2 group-hover:text-[#f6dd9f] transition-colors">
                {r.title}
              </h4>
              <p class="text-xs text-[#bdae9c] leading-relaxed">
                {r.desc}
              </p>
            </div>
            <span class="mt-4 text-[10px] font-mono text-[#d4a34b] font-bold">0{idx + 1}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Packages Section -->
    <div class="mb-14">
      <div class="text-center mb-12">
        <div class="section-badge">Packages</div>
        <h3 class="font-serif text-2xl sm:text-4xl font-bold text-white mb-3">
          Sponsorship <span class="gold-text-gradient">Packages</span>
        </h3>
        <p class="text-xs sm:text-sm text-[#c9b8a3]">Curated packages tailored to maximize brand equity and business development</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {packages.map((pkg) => (
          <div class={`glass-card rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 ${
            pkg.highlight
              ? 'border-2 border-[#d4a34b] bg-gradient-to-b from-[#24170b] to-[#140e08] shadow-[0_8px_30px_rgba(212,163,75,0.25)]'
              : 'border border-[#d4a34b]/20 bg-[#161009]/85 hover:border-[#d4a34b]/50'
          }`}>
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class={`text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-wider ${
                  pkg.highlight ? 'bg-[#d4a34b] text-black' : 'bg-[#291c0e] text-[#f6dd9f] border border-[#d4a34b]/30'
                }`}>
                  {pkg.badge}
                </span>
                {pkg.highlight && <span class="text-xs text-[#f6dd9f]">★ Premier</span>}
              </div>

              <h4 class="font-serif text-2xl font-bold text-white mb-2">
                {pkg.name}
              </h4>
              <p class="text-xs text-[#c5b59f] mb-6 min-h-[32px]">
                {pkg.tagline}
              </p>

              <div class="space-y-3 mb-8">
                {pkg.features.map((feat) => (
                  <div class="flex items-start gap-2.5 text-xs text-[#ded1be]">
                    <svg class="w-4 h-4 text-[#d4a34b] shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <span>{feat}</span>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <button 
                type="button"
                onclick="window.openModal('modal-partner')"
                class={`w-full py-3 rounded-xl text-xs font-bold tracking-wider cursor-pointer transition-all ${
                  pkg.highlight ? 'btn-gold shadow-gold-glow' : 'btn-outline-gold'
                }`}
              >
                Inquire For {pkg.name}
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Download Sponsorship Brochure CTA Banner -->
    <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-[#2a1b0c] via-[#33210e] to-[#2a1b0c] border border-[#d4a34b]/40 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div>
        <span class="text-xs uppercase font-bold tracking-widest text-[#d4a34b]">{sponsorshipDoc.badge || "Comprehensive Kit"}</span>
        <h4 class="font-serif text-2xl sm:text-3xl font-bold text-white mt-1 mb-2">
          {sponsorshipDoc.title}
        </h4>
        <p class="text-xs sm:text-sm text-[#d0beaa] max-w-xl">
          {sponsorshipDoc.description}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0">
        <button 
          type="button"
          onclick="window.openBrochureModal('sponsorship-brochure')"
          class="btn-gold px-8 py-4 rounded-xl text-xs sm:text-sm font-bold tracking-wider shrink-0 cursor-pointer shadow-gold-glow flex items-center gap-2"
        >
          <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span>Download Kit ({sponsorshipDoc.fileSize})</span>
        </button>
        <a 
          href={sponsorshipDoc.filePath} 
          download={sponsorshipDoc.fileName}
          class="text-xs text-[#f6dd9f] hover:underline px-3 py-2 flex items-center gap-1 font-semibold"
        >
          <span>Direct PDF</span>
          <span>↓</span>
        </a>
      </div>
    </div>

  </div>
</section>

<div class="gold-divider my-10"></div>
