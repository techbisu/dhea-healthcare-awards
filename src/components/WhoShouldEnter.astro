---

<section id="who-should-enter" class="relative py-20 px-4 sm:px-6 lg:px-8 bg-[#100c08]/50">
  <div class="max-w-7xl mx-auto">
    <!-- Section Title -->
    <div class="text-center mb-14">
      <div class="section-badge">Eligibility & Categories</div>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-4">
        Who Should <span class="gold-text-gradient">Enter?</span>
      </h2>
      <p class="max-w-2xl mx-auto text-sm sm:text-base text-[#c9b8a3]">
        DHEA 2026 welcomes nominations from organizations, healthcare institutions, and visionary professionals across the entire healthcare continuum.
      </p>
    </div>

    <!-- Sectors Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sectors.map((sec, i) => (
        <div class="glass-card rounded-2xl p-6 border border-[#d4a34b]/20 bg-[#161009]/85 group hover:border-[#d4a34b]/60 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-xl bg-[#2b1c0e] border border-[#d4a34b]/30 flex items-center justify-center p-2.5 shadow-inner" set:html={sec.icon} />
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-[#26190c] text-[#f6dd9f] border border-[#d4a34b]/20">
                {sec.badge}
              </span>
            </div>
            
            <h3 class="font-serif text-lg sm:text-xl font-bold text-white mb-2 group-hover:text-[#f6dd9f] transition-colors">
              {sec.title}
            </h3>

            <p class="text-xs sm:text-sm text-[#bdae9c] leading-relaxed mb-6">
              {sec.desc}
            </p>
          </div>

          <div class="pt-4 border-t border-[#2a1d0d] flex items-center justify-between">
            <span class="text-xs font-semibold text-[#f6dd9f] flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Nominate Sector →
            </span>
            <button 
              type="button"
              onclick="window.openModal('modal-nominate')"
              class="text-xs text-[#c5b59f] hover:text-white underline cursor-pointer"
            >
              Apply
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<div class="gold-divider my-10"></div>
