---
import Layout from '../layouts/Layout.astro';
import Sponsorship from '../components/Sponsorship.astro';
import Partners from '../components/Partners.astro';
---

<Layout title="Sponsorship Packages | DHEA 2026 | Brand Partnerships">
  <div class="py-12 bg-gradient-to-b from-[#181109] to-[#0c0906] border-b border-[#d4a34b]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-badge">Brand Alliances</div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white mb-4">
        Sponsorship <span class="gold-text-gradient">Opportunities</span>
      </h1>
      <p class="max-w-3xl mx-auto text-sm sm:text-base text-[#c9b8a3]">
        Elevate your brand presence before 1000+ healthcare leaders, hospital conglomerates, and medical visionaries in Kolkata.
      </p>
    </div>
  </div>
  <Sponsorship />
  <Partners />
</Layout>
