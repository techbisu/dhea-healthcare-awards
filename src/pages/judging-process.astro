---
import Layout from '../layouts/Layout.astro';
import JudgingProcess from '../components/JudgingProcess.astro';
import ImportantDates from '../components/ImportantDates.astro';
---

<Layout title="Judging Process | DHEA 2026 | Transparent & Audited Scoring">
  <div class="py-12 bg-gradient-to-b from-[#181109] to-[#0c0906] border-b border-[#d4a34b]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-badge">Integrity & Rigor</div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white mb-4">
        Judging <span class="gold-text-gradient">Process</span>
      </h1>
      <p class="max-w-3xl mx-auto text-sm sm:text-base text-[#c9b8a3]">
        A multi-tiered, independent evaluation framework supervised by industry auditors and a 50+ member jury.
      </p>
    </div>
  </div>
  <JudgingProcess />
  <ImportantDates />
</Layout>
