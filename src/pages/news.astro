---
import Layout from '../layouts/Layout.astro';
import News from '../components/News.astro';
import ImportantDates from '../components/ImportantDates.astro';
---

<Layout title="Latest News & Press Releases | DHEA 2026 | Announcements">
  <div class="py-12 bg-gradient-to-b from-[#181109] to-[#0c0906] border-b border-[#d4a34b]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-badge">Press Releases</div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white mb-4">
        News & <span class="gold-text-gradient">Updates</span>
      </h1>
      <p class="max-w-3xl mx-auto text-sm sm:text-base text-[#c9b8a3]">
        Catch the latest news, jury member announcements, and official press bulletins from DHEA 2026.
      </p>
    </div>
  </div>
  <News />
  <ImportantDates />
</Layout>
