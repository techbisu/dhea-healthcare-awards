---
import Layout from '../layouts/Layout.astro';
import JudgingProcess from '../components/JudgingProcess.astro';
import FAQ from '../components/FAQ.astro';
---

<Layout title="Entry Guidelines & Rules | DHEA 2026 | Eligibility & Submissions">
  <div class="py-12 bg-gradient-to-b from-[#181109] to-[#0c0906] border-b border-[#d4a34b]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-badge">Rules & Compliance</div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white mb-4">
        Entry <span class="gold-text-gradient">Guidelines</span>
      </h1>
      <p class="max-w-3xl mx-auto text-sm sm:text-base text-[#c9b8a3]">
        Detailed terms, eligibility periods, required documentation, and submission protocol for all award categories.
      </p>
    </div>
  </div>
  <JudgingProcess />
  <FAQ />
</Layout>
