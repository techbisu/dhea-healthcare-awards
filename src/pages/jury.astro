---
import Layout from '../layouts/Layout.astro';
import Jury from '../components/Jury.astro';
import JudgingProcess from '../components/JudgingProcess.astro';
---

<Layout title="Eminent Jury Members | DHEA 2026 | 50+ Medical & Healthcare Visionaries">
  <div class="py-12 bg-gradient-to-b from-[#181109] to-[#0c0906] border-b border-[#d4a34b]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-badge">Independent Panel</div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white mb-4">
        Eminent <span class="gold-text-gradient">Jury Members</span>
      </h1>
      <p class="max-w-3xl mx-auto text-sm sm:text-base text-[#c9b8a3]">
        Guided by over 50+ venerable healthcare visionaries, clinicians, medical council members, and pharmaceutical research directors.
      </p>
    </div>
  </div>
  <Jury />
  <JudgingProcess />
</Layout>
