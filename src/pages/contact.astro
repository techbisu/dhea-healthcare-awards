---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import FAQ from '../components/FAQ.astro';
---

<Layout title="Contact Secretariat | DHEA 2026 | Dose Daily Healthcare Excellence Awards">
  <div class="py-12 bg-gradient-to-b from-[#181109] to-[#0c0906] border-b border-[#d4a34b]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-badge">Get In Touch</div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white mb-4">
        Contact <span class="gold-text-gradient">Secretariat</span>
      </h1>
      <p class="max-w-3xl mx-auto text-sm sm:text-base text-[#c9b8a3]">
        Connect directly with our Awards Secretariat for nomination queries, delegate reservations, and partnership opportunities in Kolkata.
      </p>
    </div>
  </div>
  <Contact />
  <FAQ />
</Layout>
