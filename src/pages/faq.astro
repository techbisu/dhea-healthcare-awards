---
import Layout from '../layouts/Layout.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="Frequently Asked Questions | DHEA 2026 | Help Desk">
  <div class="py-12 bg-gradient-to-b from-[#181109] to-[#0c0906] border-b border-[#d4a34b]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-badge">Help Desk & Info</div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white mb-4">
        Frequently Asked <span class="gold-text-gradient">Questions</span>
      </h1>
      <p class="max-w-3xl mx-auto text-sm sm:text-base text-[#c9b8a3]">
        Find immediate answers to questions on eligibility, category selection, judging process, entry fees, and awards night.
      </p>
    </div>
  </div>
  <FAQ />
  <Contact />
</Layout>
